{
  "name": "whosold",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0 --cache --cache-location node_modules/.cache/eslint/",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:ci": "vitest run",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:ci && npm run build"
    "preview": "vite preview",
    "format:check": "prettier --check package.json tsconfig.json tsconfig.app.json tsconfig.node.json vite.config.ts eslint.config.js tailwind.config.js postcss.config.js vercel.json \"src/**/*.{ts,tsx,css}\"",
    "db:start": "npx --yes supabase@3.1.0 start",
    "db:stop": "npx --yes supabase@3.1.0 stop",
    "db:reset": "npx --yes supabase@3.1.0 db reset",
    "db:test": "npx --yes supabase@3.1.0 test db",
    "db:types": "npx --yes supabase@3.1.0 gen types typescript --local > src/lib/database.types.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^15.0.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.0.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.6",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
