# Copy to .env.local and fill in. Never commit real values.
# Hosted: Supabase dashboard > Project Settings > API (Project URL + anon public key).
# Local:  printed by `npm run db:start`.
# Only public values go here: the anon key is safe in the browser because RLS
# protects the data. Never put the service_role key in the frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
